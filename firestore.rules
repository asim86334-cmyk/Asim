rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['email', 'createdAt']) &&
        incoming().keys().size() <= 6 &&
        incoming().email is string &&
        incoming().createdAt == request.time;
      
      allow update: if isOwner(userId) &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);

      // Downloads subcollection
      match /downloads/{downloadId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(downloadId) &&
          incoming().keys().hasAll(['videoId', 'title', 'thumbnail', 'downloadedAt']) &&
          incoming().downloadedAt == request.time;
        allow delete: if isOwner(userId);
      }
    }
  }
}
